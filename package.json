{
  "name": "gentle-decks",
  "version": "0.3.0",
  "type": "module",
  "description": "Markdown decks that render to self-contained HTML presentations.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "gentle-shell",
    "presentation",
    "slides",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilberC/gentle-decks.git"
  },
  "bin": {
    "decks": "bin/decks.js"
  },
  "files": [
    "bin",
    "src",
    "studio",
    "themes",
    "skill",
    "FORMAT.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "skills": [
      "./skill"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:sample": "node bin/decks.js decks/sample/gentle-decks.md -o decks/sample/gentle-decks.html",
    "design:sample": "node bin/decks.js decks/sample/gentle-decks.md --design design/gentle-decks",
    "check": "node checks/check.mjs && node --test checks/*.test.mjs",
    "smoke:ui": "node checks/ui-smoke.mjs",
    "studio:demo": "node bin/decks.js studio decks/demo"
  },
  "dependencies": {
    "marked": "^15.0.0"
  }
}
